# Core Hub Server
HOST=127.0.0.1
PORT=8787
DB_PATH=./data/neko.db
HUB_TOKEN=replace-with-tailscale-shared-secret

# Model Gateway Providers (configure one or more)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner

GEMINI_API_KEY=
GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_ARK_MODEL=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Streaming ASR (Volcengine / FunASR)
VOLCENGINE_ASR_APP_ID=
VOLCENGINE_ASR_TOKEN=

# Optional TTS (Default off / stealth-safe)
TTS_ENABLED=false
TTS_PROVIDER=cosyvoice
